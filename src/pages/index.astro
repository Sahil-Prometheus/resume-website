---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Profile from '../components/Profile.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Expertise from '../components/Expertise.astro';
import SkillsStack from '../components/SkillsStack.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
---

<Base
  title="Sahil Gohel — Principal Consultant, AI & Analytics"
  description="Strategic analytics and AI consulting leader with nine years of experience advising Fortune 50 and global enterprises."
>
  <div class="landing">
    <Header />
    <Hero />
  </div>
  <main>
    <Profile />
    <Experience />
    <Projects />
    <Expertise />
    <SkillsStack />
    <Education />
    <Contact />
  </main>
  <ScrollProgress />
</Base>
