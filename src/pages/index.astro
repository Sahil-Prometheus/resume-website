---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Profile from '../components/Profile.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import SkillsStack from '../components/SkillsStack.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
---

<Base
  title="Sahil Gohel — AI & Analytics Consultant"
  description="AI and analytics consultant with nine years advising Fortune 50 and global enterprises. I find the AI use cases worth building, then get them into production."
>
  <div class="landing">
    <Header />
    <Hero />
  </div>
  <main>
    <Profile />
    <Experience />
    <Projects />
    <SkillsStack />
    <Education />
    <Contact />
  </main>
  <ScrollProgress />
</Base>
