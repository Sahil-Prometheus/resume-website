---
/* A quiet reading companion fixed to the right edge. The rail
   keeps one tick per section, but reveals only the name of the
   section currently in view. */

const index = [
  { id: 'profile', name: 'Profile' },
  { id: 'experience', name: 'Experience' },
  { id: 'projects', name: 'Selected projects' },
  { id: 'expertise', name: 'Expertise' },
  { id: 'skills', name: 'Skills & stack' },
  { id: 'education', name: 'Education' },
  { id: 'contact', name: 'Contact' },
];
---

<aside class="page-indicator">
  <nav class="pi-rail" aria-label="Page sections">
    {
      index.map((item, itemIndex) => (
        <a
          class="pi-link"
          href={`#${item.id}`}
          data-pi-link={item.id}
          style={`--pi-position: ${(itemIndex / (index.length - 1)) * 100}%`}
          aria-label={`Go to ${item.name}`}
        >
          <span class="pi-tick" aria-hidden="true" />
          <span class="pi-name">{item.name}</span>
        </a>
      ))
    }
  </nav>
</aside>

<style>
  .page-indicator {
    display: none;
  }

  @media (min-width: 75rem) {
    .page-indicator {
      display: block;
      position: fixed;
      top: 50%;
      right: 1.25rem;
      z-index: 50;
      transform: translateY(-50%);
    }

    .pi-rail {
      position: relative;
      width: 1px;
      height: clamp(18rem, 58vh, 27rem);
      border-left: 1px solid var(--hairline);
    }

    .pi-link {
      position: absolute;
      top: var(--pi-position);
      left: -1px;
      width: 4rem;
      height: 2rem;
      color: var(--ink-faint);
      transform: translateY(-50%);
    }
  }

  .pi-link {
    display: block;
  }

  .pi-tick {
    position: absolute;
    top: 50%;
    left: 0;
    display: block;
    width: 1.4rem;
    height: 1px;
    background: var(--ink-faint);
    transform: translateY(-50%);
    transition:
      width 0.45s var(--ease-out),
      background-color 0.35s var(--ease-out);
  }

  .pi-name {
    position: absolute;
    top: 50%;
    right: 1.85rem;
    left: auto;
    width: max-content;
    color: var(--vermillion);
    font-family: var(--sans);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    opacity: 0;
    pointer-events: none;
    transform: translate(0.4rem, -50%);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.45s var(--ease-out);
    user-select: none;
  }

  .pi-link:hover .pi-tick {
    width: 2rem;
    background: var(--ink-soft);
  }

  .pi-link.active .pi-tick {
    width: 4rem;
    background: var(--vermillion);
  }

  .pi-link.active .pi-name {
    opacity: 1;
    transform: translate(0, -50%);
  }
</style>
