---
/* A quiet reading companion fixed to the right edge: the page
   counter ("03 / 07") above an index of section names, all in
   horizontal type, right-aligned. The section in view glows
   terracotta; clicking a name glides there via Lenis. Only
   appears on wide screens where the right margin has room. */

const index = [
  { id: 'profile', name: 'Profile' },
  { id: 'experience', name: 'Experience' },
  { id: 'projects', name: 'Projects' },
  { id: 'expertise', name: 'Expertise' },
  { id: 'skills', name: 'Skills' },
  { id: 'education', name: 'Education' },
  { id: 'contact', name: 'Contact' },
];
---

<aside class="page-indicator" aria-label="Section index">
  <span class="pi-counter" aria-hidden="true">
    <span class="pi-current" data-pi-current>01</span>
    <span class="pi-rest">&nbsp;/&nbsp;<span data-pi-total>07</span></span>
  </span>
  <nav class="pi-index">
    {
      index.map((item) => (
        <a class="pi-link" href={`#${item.id}`} data-pi-link={item.id}>
          {item.name}
        </a>
      ))
    }
  </nav>
</aside>

<style>
  .page-indicator {
    display: none;
  }

  @media (min-width: 75rem) {
    .page-indicator {
      display: block;
      position: fixed;
      right: calc(var(--gutter) * 0.5);
      top: 50%;
      transform: translateY(-50%);
      z-index: 50;
      font-family: var(--mono);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-align: right;
      user-select: none;
    }
  }

  .pi-counter {
    display: block;
  }

  .pi-current {
    color: var(--vermillion);
    transition: color 0.3s var(--ease-out);
  }

  .pi-rest {
    color: var(--ink-faint);
  }

  .pi-index {
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .pi-link {
    color: var(--ink-faint);
    transition: color 0.35s var(--ease-out);
  }

  .pi-link:hover {
    color: var(--ink);
  }

  .pi-link.active {
    color: var(--vermillion);
  }
</style>
