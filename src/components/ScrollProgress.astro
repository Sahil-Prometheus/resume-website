---
/* A quiet reading companion: a fixed page counter on the right
   edge, set vertically — "03 / 07" — showing which numbered
   section is in view. Updates in step with Lenis' scroll. */
---

<div class="page-indicator" aria-hidden="true">
  <span class="pi-current" data-pi-current>01</span>
  <span class="pi-rest">&nbsp;/&nbsp;<span data-pi-total>07</span></span>
</div>

<style>
  .page-indicator {
    display: none;
  }

  @media (min-width: 56rem) {
    .page-indicator {
      display: block;
      position: fixed;
      right: calc(var(--gutter) * 0.5);
      top: 50%;
      transform: translateY(-50%);
      z-index: 50;
      writing-mode: vertical-rl;
      font-family: var(--mono);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      user-select: none;
    }
  }

  .pi-current {
    color: var(--ink);
    transition: color 0.3s var(--ease-out);
  }

  .pi-rest {
    color: var(--ink-faint);
  }
</style>
