---
import { education } from '../content/resume';
---

<section class="section shell" id="education" aria-label="Education">
  <p class="kicker" data-reveal><span class="kicker-num">05</span> &mdash; Education</p>
  <div class="edu">
    <div class="edu-block" data-reveal>
      <h3 class="edu-label">Degrees</h3>
      {
        education.degrees.map((d) => (
          <div class="edu-item">
            <p class="edu-title">{d.title}</p>
            <p class="edu-meta">
              {d.school}, {d.place}
            </p>
            <p class="edu-period">{d.period}</p>
          </div>
        ))
      }
    </div>

    <div class="edu-block" data-reveal style="--reveal-delay: 0.08s">
      <h3 class="edu-label">Certificates</h3>
      {
        education.certificates.map((c) => (
          <div class="edu-item">
            <p class="edu-title">{c.title}</p>
            <p class="edu-meta">
              {c.school} &nbsp;&middot;&nbsp; {c.year}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="languages" data-reveal>
    <h3 class="edu-label languages-heading">Languages</h3>
    <p class="languages-line">
      {
        education.languages.map((l, i) => (
          <>
            <span class="lang-name">{l.name}</span>
            <span class="lang-level">{l.level}</span>
            {i < education.languages.length - 1 && (
              <span class="lang-sep" aria-hidden="true">
                &middot;
              </span>
            )}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .edu {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.75rem;
  }

  @media (min-width: 40rem) {
    .edu {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .edu-label {
    font-family: var(--mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    border-top: 1px solid var(--hairline);
    padding-top: 1.25rem;
  }

  .edu-item {
    margin-top: 1.25rem;
  }

  .edu-title {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .edu-meta {
    font-size: var(--text-small);
    color: var(--ink-soft);
    margin-top: 0.25rem;
  }

  .edu-period {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-faint);
    margin-top: 0.25rem;
  }

  /* Languages — one centred row spanning the full section */
  .languages {
    grid-column: 1 / -1;
    text-align: center;
    margin-top: 1rem;
  }

  .languages-heading {
    display: inline-block;
    border-top: none;
    padding-top: 0;
  }

  .languages-line {
    margin-top: 0.9rem;
    font-size: var(--text-small);
    white-space: nowrap;
  }

  .lang-name {
    color: var(--ink);
  }

  .lang-level {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
    margin-left: 0.3rem;
  }

  .lang-sep {
    color: var(--ink-faint);
    margin-inline: 0.9rem;
  }

  /* On small screens, names only — keeps the single row intact */
  @media (max-width: 40rem) {
    .lang-level {
      display: none;
    }
  }
</style>
