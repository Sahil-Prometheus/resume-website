---
import { education } from '../content/resume';

/* Degrees and certificates share grid rows, so a tall entry in one
   column can never push the other column out of alignment. */
const rows = Array.from(
  { length: Math.max(education.degrees.length, education.certificates.length) },
  (_, i) => ({ degree: education.degrees[i], certificate: education.certificates[i] }),
);
---

<section class="section shell" id="education" aria-label="Education">
  <p class="kicker" data-reveal><span class="kicker-num">05</span> &mdash; Education</p>
  <div class="edu" data-reveal>
    <h3 class="edu-label edu-label-deg">Degrees</h3>
    <h3 class="edu-label edu-label-cert">Certificates</h3>
    {
      rows.map((row) => (
        <>
          <div class="edu-item edu-cell-deg">
            {row.degree && (
              <>
                <p class="edu-title">{row.degree.title}</p>
                <p class="edu-meta">
                  {row.degree.school}, {row.degree.place}
                </p>
                <p class="edu-period">{row.degree.period}</p>
              </>
            )}
          </div>
          <div class="edu-item edu-cell-cert">
            {row.certificate && (
              <>
                <p class="edu-title">{row.certificate.title}</p>
                <p class="edu-meta">
                  {row.certificate.school} &nbsp;&middot;&nbsp; {row.certificate.year}
                </p>
              </>
            )}
          </div>
        </>
      ))
    }
  </div>

  <div class="languages" data-reveal>
    <h3 class="edu-label languages-heading">Languages</h3>
    <p class="languages-line">
      {
        education.languages.map((l, i) => (
          <>
            <span class="lang-name">{l.name}</span>
            <span class="lang-level">{l.level}</span>
            {i < education.languages.length - 1 && (
              <span class="lang-sep" aria-hidden="true">
                &middot;
              </span>
            )}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .edu {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 2rem;
    row-gap: 1.5rem;
  }

  .edu-label {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    border-top: 1px solid var(--hairline);
    padding-top: 1.25rem;
  }

  /* Phones: stack as two grouped blocks instead of interleaved rows */
  @media (max-width: 40rem) {
    .edu {
      grid-template-columns: 1fr;
    }

    .edu-label-deg {
      order: 0;
    }

    .edu-cell-deg {
      order: 1;
    }

    .edu-label-cert {
      order: 2;
      margin-top: 1.5rem;
    }

    .edu-cell-cert {
      order: 3;
    }
  }

  .edu-title {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-case);
    font-weight: 600;
    line-height: 1.3;
  }

  .edu-meta {
    font-size: var(--text-small);
    color: var(--ink-soft);
    margin-top: 0.25rem;
  }

  .edu-period {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-meta);
    color: var(--ink-faint);
    margin-top: 0.25rem;
  }

  /* Languages — one centred row spanning the full section */
  .languages {
    grid-column: 1 / -1;
    text-align: center;
    margin-top: 1rem;
  }

  .languages-heading {
    display: inline-block;
    border-top: none;
    padding-top: 0;
  }

  .languages-line {
    margin-top: 0.9rem;
    font-size: var(--text-small);
    white-space: nowrap;
  }

  .lang-name {
    color: var(--ink);
  }

  .lang-level {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-tag);
    color: var(--ink-faint);
    margin-left: 0.3rem;
  }

  .lang-sep {
    color: var(--ink-faint);
    margin-inline: 0.9rem;
  }

  /* On small screens, names only — keeps the single row intact */
  @media (max-width: 40rem) {
    .lang-level {
      display: none;
    }
  }
</style>
