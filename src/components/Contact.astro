---
import { person, contact } from '../content/resume';
import ResumeButton from './ResumeButton.astro';
import SocialIcons from './SocialIcons.astro';

const year = new Date().getFullYear();
---

<section class="section shell" id="contact" aria-label="Contact">
  <p class="kicker" data-reveal><span class="kicker-num">07</span> &mdash; Contact</p>
  <div class="contact-body">
    <h2 class="contact-heading" data-reveal>{contact.heading}</h2>
    <p class="contact-note" data-reveal style="--reveal-delay: 0.08s">{contact.note}</p>
    <p class="contact-email" data-reveal style="--reveal-delay: 0.16s">
      <a class="u-link" href={`mailto:${person.email}`}>{person.email}</a>
    </p>
    <p class="contact-alt" data-reveal style="--reveal-delay: 0.24s">
      <a class="u-link" href={person.linkedin.url} target="_blank" rel="noopener noreferrer">
        {person.linkedin.label}
      </a>
      <span class="dot" aria-hidden="true">&middot;</span>
      {person.phone}
    </p>
    <div class="contact-actions" data-reveal style="--reveal-delay: 0.28s">
      <SocialIcons />
      <ResumeButton />
    </div>
  </div>
</section>

<footer class="footer">
  <div class="shell footer-inner">
    <p>&copy; {year} {person.name}</p>
    <p>{person.location}</p>
  </div>
</footer>

<style>
  .contact-heading {
    font-family: var(--font);
    font-stretch: var(--wdth-display);
    font-size: var(--text-section);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .contact-note {
    max-width: 32rem;
    color: var(--ink-soft);
    margin-top: 1.75rem;
  }

  .contact-email {
    margin-top: 2.5rem;
  }

  .contact-email a {
    font-family: var(--font);
    font-stretch: var(--wdth-display);
    font-size: var(--text-contact);
    font-weight: 600;
  }

  .contact-alt {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-meta);
    color: var(--ink-soft);
    margin-top: 1.5rem;
  }

  .dot {
    color: var(--ink-faint);
  }

  .contact-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.75rem;
  }

  .footer {
    border-top: 1px solid var(--hairline);
    margin-top: calc(var(--section-gap) / 2);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-tag);
    color: var(--ink-faint);
  }
</style>
