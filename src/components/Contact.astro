---
import { person, contact } from '../content/resume';
import ResumeButton from './ResumeButton.astro';
import QrCode from './QrCode.astro';

const year = new Date().getFullYear();
const resumeUrl = new URL('/Sahil-Gohel-Resume.pdf', Astro.site).href;
---

<section class="section shell" id="contact" aria-label="Contact">
  <p class="kicker" data-reveal>06 &mdash; Contact</p>
  <div class="contact-body">
    <h2 class="contact-heading" data-reveal>{contact.heading}</h2>
    <p class="contact-note" data-reveal style="--reveal-delay: 0.08s">{contact.note}</p>
    <p class="contact-email" data-reveal style="--reveal-delay: 0.16s">
      <a class="u-link" href={`mailto:${person.email}`}>{person.email}</a>
    </p>
    <p class="contact-alt" data-reveal style="--reveal-delay: 0.24s">
      <a class="u-link" href={person.linkedin.url} target="_blank" rel="noopener noreferrer">
        {person.linkedin.label}
      </a>
      <span class="dot" aria-hidden="true">&middot;</span>
      {person.phone}
    </p>
    <div class="contact-actions" data-reveal style="--reveal-delay: 0.32s">
      <ResumeButton />
    </div>
  </div>
</section>

<footer class="footer">
  <div class="shell footer-inner">
    <div class="footer-text">
      <p>&copy; {year} {person.name}</p>
      <p>{person.location}</p>
    </div>
    <QrCode url={resumeUrl} caption="Scan for résumé" size={80} />
  </div>
</footer>

<style>
  .contact-heading {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: var(--text-display);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .contact-note {
    max-width: 32rem;
    color: var(--ink-soft);
    margin-top: 1.75rem;
  }

  .contact-email {
    margin-top: 2.5rem;
  }

  .contact-email a {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.35rem, 2.5vw + 0.5rem, 1.9rem);
    font-weight: 350;
  }

  .contact-alt {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin-top: 1.5rem;
  }

  .dot {
    color: var(--ink-faint);
  }

  .contact-actions {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 3rem;
  }

  .footer {
    border-top: 1px solid var(--hairline);
    margin-top: calc(var(--section-gap) / 2);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding-block: 2rem;
  }

  .footer-text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
</style>
