---
import { stats } from '../content/resume';
---

<div class="stats" aria-label="Key numbers">
  {
    stats.map((stat, i) => (
      <div class="stat">
        <p class:list={['stat-value', { compact: stat.compact }]}>
          <span class="stat-num" data-stat-focus>
            {stat.value}
            {stat.suffix && <span class="stat-suffix">{stat.suffix}</span>}
          </span>
        </p>
        <p class="stat-label" data-hero="fade" style={`--d: ${0.9 + i * 0.22}s`}>
          {stat.label}
        </p>
      </div>
    ))
  }
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2rem;
    max-width: 52rem;
    margin-top: clamp(0.65rem, 2.4svh, 2rem);
  }

  @media (min-width: 40rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  /* Phones: keep one slim row of four so the hero stays one screen */
  @media (max-width: 40rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.9rem;
      margin-top: 1rem;
    }

    .stat {
      padding-top: 0.6rem;
    }

    .stat-label {
      margin-top: 0.4rem;
    }
  }

  .stat {
    border-top: 1px solid var(--hairline);
    padding-top: 0.85rem;
  }

  .stat-value {
    font-family: var(--font);
    font-stretch: var(--wdth-display);
    font-size: var(--text-stat);
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    overflow: visible;
  }

  .stat-value.compact {
    font-size: clamp(0.7rem, 2.4vw, 1.15rem);
    letter-spacing: -0.03em;
    font-variant-numeric: normal;
  }

  /* First paint is already misty, so the numbers never flash
     sharp and then jump. JS eases them into focus. */
  .stat-num {
    display: inline-block;
    padding: 0.2em 0.25em;
    margin: -0.2em -0.25em;
    animation: none;
  }

  :global(.js) .stat-num {
    filter: blur(22px);
    opacity: 0.12;
  }

  .stat-suffix {
    font-size: 0.6em;
    margin-left: 0.05em;
    color: var(--ink-soft);
  }

  .stat-label {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-tag);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }
</style>
