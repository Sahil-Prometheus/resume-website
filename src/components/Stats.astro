---
import { stats } from '../content/resume';
---

<div class="stats" data-hero="fade" style="--d: 0.9s" aria-label="Key numbers">
  {
    stats.map((stat, i) => (
      <div class="stat">
        <p class="stat-value">
          <span data-count={stat.value} data-delay={i * 0.05}>
            {stat.value}
          </span>
          <span class="stat-suffix">{stat.suffix}</span>
        </p>
        <p class="stat-label">{stat.label}</p>
      </div>
    ))
  }
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2rem;
    margin-top: clamp(1.25rem, 3vh, 2rem);
  }

  @media (min-width: 40rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  /* Phones: keep one slim row of four so the hero stays one screen */
  @media (max-width: 40rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.9rem;
      margin-top: 1rem;
    }

    .stat {
      padding-top: 0.6rem;
    }

    .stat-value {
      font-size: 1.45rem;
    }

    .stat-label {
      font-size: 0.5625rem;
      letter-spacing: 0.08em;
      margin-top: 0.4rem;
    }
  }

  .stat {
    border-top: 1px solid var(--hairline);
    padding-top: 0.85rem;
  }

  .stat-value {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    font-weight: 300;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-suffix {
    font-size: 0.6em;
    margin-left: 0.05em;
    color: var(--ink-soft);
  }

  .stat-label {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }
</style>
