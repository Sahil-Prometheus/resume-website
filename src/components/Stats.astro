---
import { stats } from '../content/resume';
---

<div class="stats" aria-label="Key numbers">
  {
    stats.map((stat, i) => (
      <div class="stat">
        <p class="stat-value">
          <span class="stat-figure" style={`--d: ${0.55 + i * 0.22}s`}>
            {stat.value}
            <span class="stat-suffix">{stat.suffix}</span>
          </span>
        </p>
        <p class="stat-label" data-hero="fade" style={`--d: ${0.9 + i * 0.22}s`}>
          {stat.label}
        </p>
      </div>
    ))
  }
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2rem;
    margin-top: clamp(1.25rem, 3vh, 2rem);
  }

  @media (min-width: 40rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  /* Phones: keep one slim row of four so the hero stays one screen */
  @media (max-width: 40rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.9rem;
      margin-top: 1rem;
    }

    .stat {
      padding-top: 0.6rem;
    }

    .stat-value {
      font-size: 1.45rem;
    }

    .stat-label {
      font-size: 0.5625rem;
      letter-spacing: 0.08em;
      margin-top: 0.4rem;
    }
  }

  .stat {
    border-top: 1px solid var(--hairline);
    padding-top: 0.85rem;
  }

  .stat-value {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    font-weight: 300;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    overflow: visible;
  }

  /* Soft mist clearing — the number is already there, it just
     comes into focus. Long and unhurried, not a count-up. */
  .stat-figure {
    display: inline-block;
    padding: 0.2em 0.25em;
    margin: -0.2em -0.25em;
  }

  :global(.js) .stat-figure {
    animation: stat-focus 2.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0.55s);
  }

  .stat-suffix {
    font-size: 0.6em;
    margin-left: 0.05em;
    color: var(--ink-soft);
  }

  .stat-label {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }

  @keyframes stat-focus {
    from {
      filter: blur(16px);
      opacity: 0;
    }

    45% {
      filter: blur(7px);
      opacity: 0.55;
    }

    to {
      filter: blur(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .stat-figure {
      animation: none;
      filter: none;
      opacity: 1;
    }
  }
</style>
