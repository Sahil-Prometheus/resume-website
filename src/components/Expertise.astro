---
import { expertise } from '../content/resume';
---

<section class="section shell" id="expertise" aria-label="Expertise">
  <p class="kicker" data-reveal><span class="kicker-num">04</span> &mdash; Expertise</p>
  <div class="groups">
    {
      expertise.map((group, i) => (
        <div class="group" data-reveal style={`--reveal-delay: ${0.08 * i}s`}>
          <h3 class="group-label">{group.label}</h3>
          <ul class="group-skills">
            {group.skills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 40rem) {
    .groups {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .group {
    border-top: 1px solid var(--hairline);
    padding-top: 1.25rem;
  }

  .group-label {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .group-skills {
    list-style: none;
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .group-skills li {
    font-family: var(--font);
    font-stretch: var(--wdth-body);
    font-size: var(--text-list);
    font-weight: 400;
    line-height: 1.45;
    color: var(--ink-soft);
  }
</style>
