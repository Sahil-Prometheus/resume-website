---
import { skillsStack } from '../content/resume';
---

<section class="section shell skills-section" id="skills" aria-label="Skills and stack">
  <p class="kicker skills-kicker" data-reveal>
    <span class="kicker-num">05</span> &mdash; Skills &amp; Stack
  </p>

  <div class="skills-intro" data-reveal style="--reveal-delay: 0.06s">
    <h2>{skillsStack.heading}</h2>
    <p>{skillsStack.introduction}</p>
  </div>

  <div class="skills-body">
    <div class="skills-block">
      <h3 data-reveal>Skills</h3>

      <div class="phase-grid" role="list">
        {
          skillsStack.phases.map((phase, phaseIndex) => (
            <article
              class="phase"
              role="listitem"
              data-reveal
              style={`--reveal-delay: ${phaseIndex * 0.08}s`}
            >
              <span class="phase-rule" aria-hidden="true" />
              <h4>{phase.title}</h4>
              <p class="phase-description">{phase.description}</p>
              <ul class="capability-list" aria-label={`${phase.title} capabilities`}>
                {phase.capabilities.map((capability) => (
                  <li>{capability}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="stack-block">
        <h3 data-reveal>Stack</h3>
        <dl class="stack-grid" data-reveal style="--reveal-delay: 0.08s">
          {
            skillsStack.stack.map((group) => (
              <div class="stack-group">
                <dt>{group.label}</dt>
                <dd>{group.technologies}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-kicker::after {
    display: none;
  }

  .skills-intro {
    max-width: 41rem;
  }

  .skills-intro h2 {
    font-family: var(--font);
    font-stretch: var(--wdth-display);
    font-size: var(--text-brand);
    font-weight: 650;
    line-height: 1.16;
    letter-spacing: -0.03em;
  }

  .skills-intro p {
    max-width: 31rem;
    margin-top: 0.85rem;
    color: var(--ink-soft);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .skills-body {
    grid-column: 1 / -1;
  }

  .skills-block > h3,
  .stack-block > h3 {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-body);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .phase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2.6vw, 2rem);
    margin-top: 1.2rem;
  }

  .phase-rule {
    position: relative;
    display: block;
    width: 100%;
    height: 1px;
    margin-bottom: 1.15rem;
    background: var(--hairline);
  }

  .phase-rule::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 5px;
    height: 5px;
    border: 1px solid var(--ink-faint);
    border-radius: 50%;
    background: var(--paper);
    content: '';
    transform: translateY(-50%);
  }

  .phase:first-child .phase-rule::before {
    border-color: var(--ink);
    background: var(--ink);
  }

  .phase h4 {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-phase);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .phase-description {
    max-width: 15rem;
    margin-top: 0.3rem;
    color: var(--ink-soft);
    font-size: var(--text-meta);
    line-height: 1.45;
  }

  .capability-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.4rem;
    margin-top: 1.2rem;
    list-style: none;
  }

  .capability-list li {
    width: fit-content;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.34rem 0.4rem;
    background: color-mix(in srgb, var(--ink) 4%, var(--paper));
    color: var(--ink);
    font-size: var(--text-meta);
    line-height: 1.15;
    white-space: nowrap;
    transition:
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .capability-list li:hover {
    border-color: var(--vermillion);
    color: var(--vermillion);
  }

  .stack-block {
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2.6vw, 2rem);
    margin-top: 1.2rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1.35rem;
  }

  .stack-group dt {
    color: var(--ink-faint);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-tag);
    line-height: 1.3;
  }

  .stack-group dd {
    margin-top: 0.55rem;
    color: var(--ink-soft);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  @media (min-width: 56rem) {
    .skills-section {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    .skills-intro {
      grid-column: 2;
    }
  }

  @media (max-width: 44rem) {
    .phase-grid,
    .stack-grid {
      grid-template-columns: 1fr;
    }

    .phase-grid {
      gap: 2.5rem;
    }

    .phase-description {
      max-width: 20rem;
    }

    .stack-grid {
      gap: 1.5rem;
    }

    .stack-group + .stack-group {
      border-top: 1px solid var(--hairline);
      padding-top: 1.5rem;
    }
  }
</style>
