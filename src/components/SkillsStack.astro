---
import { skillsStack } from '../content/resume';
---

<section class="section shell" id="skills" aria-label="Skills and stack">
  <p class="kicker" data-reveal><span class="kicker-num">05</span> &mdash; Skills &amp; Stack</p>

  <div class="skills-grid" role="list">
    {
      skillsStack.map((card, i) => (
        <article
          class="skill-card"
          role="listitem"
          data-reveal
          style={`--reveal-delay: ${(i % 3) * 0.08 + Math.floor(i / 3) * 0.05}s`}
        >
          <p class="skill-label">{card.label}</p>
          <h3 class="skill-title">{card.title}</h3>
          <p class="skill-desc">{card.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* Hairline-divided grid: the gaps let the divider colour show
     through, so every cell edge is a perfect 1px line. */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border-block: 1px solid var(--hairline);
  }

  .skill-card {
    background: var(--paper);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    display: flex;
    flex-direction: column;
    min-height: 13rem;
    transition: background-color 0.45s var(--ease-out);
  }

  .skill-card:hover {
    background: var(--paper-warm);
  }

  .skill-label {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    transition: color 0.45s var(--ease-out);
  }

  .skill-card:hover .skill-label {
    color: var(--vermillion);
  }

  .skill-title {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.3rem, 1.9vw, 1.6rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 1.1rem;
  }

  .skill-desc {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--ink-soft);
    margin-top: auto;
    padding-top: 1.75rem;
  }

  @media (max-width: 64rem) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .skill-card {
      min-height: 0;
    }
  }
</style>
