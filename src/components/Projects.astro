---
import { projects } from '../content/resume';
---

<section class="section shell" id="projects" aria-label="Selected projects">
  <p class="kicker" data-reveal>03 &mdash; Selected Projects</p>
  <ol class="index">
    {
      projects.map((project, i) => (
        <li class="index-row" data-reveal style={`--reveal-delay: ${0.05 * i}s`}>
          <span class="index-year">{project.year}</span>
          <div class="index-body">
            <h3 class="index-title">{project.title}</h3>
            <p class="index-desc">{project.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .index {
    list-style: none;
  }

  .index-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.25rem;
    padding-block: 1.4rem;
  }

  .index-row + .index-row {
    border-top: 1px solid var(--hairline);
  }

  .index-year {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-faint);
    padding-top: 0.35em;
  }

  .index-title {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .index-desc {
    font-size: var(--text-small);
    color: var(--ink-soft);
    margin-top: 0.35rem;
    max-width: 34rem;
  }
</style>
