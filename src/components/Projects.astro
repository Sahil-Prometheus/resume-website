---
import { projects } from '../content/resume';
---

<section class="section shell" id="projects" aria-label="Selected projects">
  <p class="kicker" data-reveal><span class="kicker-num">03</span> &mdash; Selected Projects</p>
  <ol class="index">
    {
      projects.map((project, i) => (
        <li class="index-row" data-reveal style={`--reveal-delay: ${0.05 * i}s`}>
          <span class="index-year">{project.year}</span>
          <div class="index-body">
            <h3 class="index-title">{project.title}</h3>
            <p class:list={['index-desc', { long: Boolean(project.href) }]}>{project.description}</p>
            {project.href && (
              <a class="index-link u-link" href={project.href}>
                Read the case study →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .index {
    list-style: none;
  }

  .index-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.25rem;
    padding-block: 1.4rem;
  }

  .index-row + .index-row {
    border-top: 1px solid var(--hairline);
  }

  .index-year {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-meta);
    color: var(--ink-faint);
    padding-top: 0.35em;
  }

  .index-title {
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-case);
    font-weight: 600;
    line-height: 1.25;
  }

  .index-desc {
    font-size: var(--text-small);
    color: var(--ink-soft);
    margin-top: 0.35rem;
    max-width: 34rem;
  }

  .index-desc.long {
    max-width: 44rem;
  }

  .index-link {
    display: inline-block;
    margin-top: 0.55rem;
    font-family: var(--font);
    font-stretch: var(--wdth-ui);
    font-size: var(--text-meta);
    font-weight: 500;
    color: var(--ink);
  }
</style>
