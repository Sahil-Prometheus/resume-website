---
import { person } from '../content/resume';
import SocialIcons from './SocialIcons.astro';

const nav = [
  { label: 'Profile', href: '#profile' },
  { label: 'Experience', href: '#experience' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="header">
  <div class="shell header-inner">
    <a href="#top" class="wordmark">{person.name}</a>
    <div class="header-right">
      <nav aria-label="Page sections">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a class="nav-link u-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="header-social">
        <SocialIcons />
      </div>
      <button
        class="theme-toggle"
        data-theme-toggle
        type="button"
        aria-label="Toggle colour theme"
        title="Toggle light / dark"
      >
        <span class="toggle-window" aria-hidden="true">
          <span class="toggle-track" data-theme-track>
            <span class="toggle-glyph">日</span>
            <span class="toggle-glyph">月</span>
          </span>
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    padding-top: clamp(1.4rem, 4vh, 2.25rem);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
  }

  .wordmark {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .header-right {
    display: flex;
    align-items: baseline;
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  .header-social {
    display: flex;
    align-items: center;
  }

  /* Slightly smaller marks so they sit quietly beside the nav */
  .header-social :global(.social-link svg) {
    width: 15px;
    height: 15px;
  }

  /* Phones: the icons live in the Contact section instead */
  @media (max-width: 40rem) {
    .header-social {
      display: none;
    }
  }

  nav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    list-style: none;
  }

  .nav-link {
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.35s var(--ease-out);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  /* Sun/moon toggle — a tiny window where 日 (sun) and 月 (moon)
     rise and set as the theme flips. Kanji fall back to the system
     Japanese face, which suits them better than the Latin serif. */
  .theme-toggle {
    background: none;
    border: none;
    padding: 0 0 2px;
    cursor: pointer;
    color: var(--ink-soft);
    transition: color 0.35s var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--vermillion);
  }

  .toggle-window {
    display: block;
    height: 1.15em;
    overflow: hidden;
    font-size: 1.05rem;
  }

  .toggle-track {
    display: flex;
    flex-direction: column;
    transition: transform 0.6s var(--ease-out);
  }

  .toggle-glyph {
    display: block;
    height: 1.15em;
    line-height: 1.15em;
    text-align: center;
  }

  /* Dark mode: the sun sets, the moon rises into view */
  .theme-toggle[data-state='dark'] .toggle-track {
    transform: translateY(-1.15em);
  }

  @media (prefers-reduced-motion: reduce) {
    .toggle-track {
      transition: none;
    }
  }
</style>
