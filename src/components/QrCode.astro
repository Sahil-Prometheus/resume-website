---
/* Generates a QR code as an SVG at build time — no external
   service involved. The QR sits on a small white card so it
   stays scannable in both light and dark mode. */
import QRCode from 'qrcode';

interface Props {
  url: string;
  caption?: string;
  size?: number;
}

const { url, caption, size = 96 } = Astro.props;

const svg = await QRCode.toString(url, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#1c1b19', light: '#00000000' },
});
---

<figure class="qr-card">
  <span class="qr-image" style={`width:${size}px;height:${size}px`} set:html={svg} />
  {caption && <figcaption class="qr-caption">{caption}</figcaption>}
</figure>

<style>
  .qr-card {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    background: #faf8f3;
    border: 1px solid var(--hairline);
    padding: 1rem;
    border-radius: 4px;
  }

  .qr-image {
    display: block;
  }

  .qr-image :global(svg) {
    width: 100%;
    height: 100%;
  }

  .qr-caption {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6f6a61;
    text-align: center;
  }
</style>
