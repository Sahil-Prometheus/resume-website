---
import { person } from '../content/resume';
---

<section class="hero shell" id="top" aria-label="Introduction">
  <p class="hero-role" data-reveal>{person.role}</p>

  <h1 class="hero-name" data-reveal style="--reveal-delay: 0.1s">
    {person.name}
  </h1>

  <p class="hero-tagline" data-reveal style="--reveal-delay: 0.2s">
    {person.tagline}
  </p>

  <div class="hero-meta" data-reveal style="--reveal-delay: 0.3s">
    <span>{person.location}</span>
    <span class="dot" aria-hidden="true">&middot;</span>
    <a class="u-link" href={`mailto:${person.email}`}>{person.email}</a>
    <span class="dot" aria-hidden="true">&middot;</span>
    <a class="u-link" href={person.linkedin.url} target="_blank" rel="noopener noreferrer">
      LinkedIn
    </a>
  </div>

  <div class="seal" data-reveal style="--reveal-delay: 0.4s" aria-hidden="true">
    SG
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(5rem, 15vh, 9.5rem);
    padding-bottom: calc(var(--section-gap) / 2);
  }

  .hero-role {
    font-family: var(--mono);
    font-size: var(--text-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: clamp(1.5rem, 3vh, 2.25rem);
  }

  .hero-name {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: var(--text-display);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  .hero-tagline {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-style: italic;
    font-size: var(--text-lede);
    font-weight: 340;
    line-height: 1.45;
    max-width: 30rem;
    margin-top: clamp(1.5rem, 3.5vh, 2.5rem);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin-top: clamp(2rem, 5vh, 3.25rem);
  }

  .hero-meta a {
    color: var(--ink);
  }

  .dot {
    color: var(--ink-faint);
  }

  /* The hanko seal — a small stamp of authenticity after the signature */
  .seal {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-top: clamp(2.5rem, 6vh, 4rem);
    background: var(--vermillion);
    border-radius: 3px;
    color: var(--paper);
    font-family: var(--serif);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    user-select: none;
  }
</style>
