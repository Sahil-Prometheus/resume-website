---
import { person } from '../content/resume';
import ResumeButton from './ResumeButton.astro';
import Stats from './Stats.astro';

const [firstName, ...rest] = person.name.split(' ');
const lastName = rest.join(' ');
---

<section class="hero" id="top" aria-label="Introduction">
  <div class="shell hero-inner">
    <p class="hero-role" data-hero="fade" style="--d: 0.05s">{person.role}</p>

    <h1 class="hero-name">
      <span class="line">
        <span class="line-inner" data-hero="rise" style="--d: 0.15s">{firstName}</span>
      </span>
      <span class="line line-indent">
        <span class="line-inner italic" data-hero="rise" style="--d: 0.3s"
          >{lastName}<span class="seal" data-hero="stamp" style="--d: 0.9s" aria-hidden="true"
            >SG</span
          ></span
        >
      </span>
    </h1>

    <div class="hero-rule" data-hero="draw" style="--d: 0.75s" aria-hidden="true"></div>

    <Stats />

    <div class="hero-aside" data-hero="fade" style="--d: 1.1s">
      <p class="hero-tagline">{person.tagline}</p>
    </div>

    <div class="hero-foot" data-hero="fade" style="--d: 1.25s">
      <p class="hero-meta">
        {person.location}
        <span class="dot" aria-hidden="true">&middot;</span>
        <a class="u-link" href={`mailto:${person.email}`}>{person.email}</a>
        <span class="dot" aria-hidden="true">&middot;</span>
        <a class="u-link" href={person.linkedin.url} target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>
      </p>
      <p class="scroll-cue" aria-hidden="true">Scroll <span class="cue-line"></span></p>
      <ResumeButton />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .hero-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    padding-top: clamp(1.5rem, 4vh, 2.5rem);
    padding-bottom: clamp(1.25rem, 3vh, 2rem);
  }

  .hero-role {
    font-family: var(--mono);
    font-size: var(--text-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* The signature — oversized, two movements. Scales with
     viewport height too, so the first screen always fits. */
  .hero-name {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(3.75rem, min(13.5vw, 16.5vh), 9.5rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-top: clamp(0.75rem, 2vh, 1.5rem);
  }

  .line {
    display: block;
    overflow: hidden;
    padding: 0 0.08em 0.1em;
    margin: 0 -0.08em -0.1em;
  }

  .line-inner {
    display: inline-block;
  }

  .line-indent {
    margin-left: clamp(2.5rem, 9vw, 8rem);
  }

  .italic {
    font-style: italic;
    font-weight: 340;
  }

  /* The hanko stamp, sitting on the signature's baseline */
  .seal {
    display: inline-grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    margin-left: 0.22em;
    vertical-align: baseline;
    background: var(--vermillion);
    border-radius: 0.14em;
    color: #faf8f3;
    font-family: var(--serif);
    font-size: clamp(0.7rem, 1.35vw, 0.95rem);
    font-style: normal;
    letter-spacing: 0.04em;
    user-select: none;
  }

  .hero-rule {
    height: 1px;
    background: var(--hairline);
    margin-top: clamp(1.25rem, 3vh, 2rem);
    transform-origin: left;
  }

  /* Tagline floats right — asymmetric balance */
  .hero-aside {
    align-self: flex-end;
    max-width: 25rem;
    margin-top: clamp(1.25rem, 2.5vh, 1.75rem);
  }

  .hero-tagline {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-style: italic;
    font-size: var(--text-lede);
    font-weight: 340;
    line-height: 1.45;
  }

  /* Bottom row: contact left, cue centre, download right */
  .hero-foot {
    margin-top: auto;
    padding-top: clamp(1.25rem, 2.5vh, 1.75rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    justify-self: start;
  }

  .hero-meta a {
    color: var(--ink);
  }

  .dot {
    color: var(--ink-faint);
  }

  .scroll-cue {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    justify-self: center;
  }

  .hero-foot :global(.resume-button) {
    justify-self: end;
  }

  .cue-line {
    width: 2.75rem;
    height: 1px;
    background: var(--vermillion);
    animation: cue-pulse 2.6s ease-in-out infinite;
  }

  @media (max-width: 40rem) {
    .hero-inner {
      padding-top: 1.25rem;
      padding-bottom: 1rem;
    }

    .hero-name {
      margin-top: 0.5rem;
    }

    .hero-rule {
      margin-top: 1rem;
    }

    .hero-aside {
      margin-top: 1rem;
    }

    .hero-foot {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding-top: 1rem;
    }

    .hero-meta,
    .scroll-cue,
    .hero-foot :global(.resume-button) {
      justify-self: start;
    }

    .scroll-cue {
      display: none;
    }
  }

  @keyframes cue-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* ---------- Load choreography (JS-enabled browsers only) ---------- */

  @keyframes hero-rise {
    from {
      transform: translateY(112%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes hero-stamp {
    from {
      opacity: 0;
      transform: scale(1.5);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .js [data-hero] {
    animation-duration: 1s;
    animation-timing-function: var(--ease-out);
    animation-fill-mode: both;
    animation-delay: var(--d, 0s);
  }

  .js [data-hero='rise'] {
    animation-name: hero-rise;
    animation-duration: 1.15s;
  }

  .js [data-hero='fade'] {
    animation-name: hero-fade;
  }

  .js [data-hero='draw'] {
    animation-name: hero-draw;
    animation-duration: 1.3s;
  }

  .js [data-hero='stamp'] {
    animation-name: hero-stamp;
    animation-duration: 0.5s;
  }

  @media (prefers-reduced-motion: reduce) {
    .js [data-hero] {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .cue-line {
      animation: none;
    }
  }
</style>
