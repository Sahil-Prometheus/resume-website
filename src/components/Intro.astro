---
import { person } from '../content/resume';

/* Landing intro: the name fills the screen in four giant rows —
   alternating solid ink and hairline outline — then the whole
   panel lifts like a curtain to reveal the hero. Only ever shown
   when <html> has .intro-playing (set inline before first paint,
   skipped for reduced-motion visitors). Click anywhere to skip. */
---

<div class="intro" data-intro aria-hidden="true">
  <div class="intro-progress"></div>
  <div class="intro-rows">
    <span class="intro-row">{person.name}</span>
    <span class="intro-row">{person.name}</span>
    <span class="intro-row">{person.name}</span>
    <span class="intro-row">{person.name}</span>
  </div>
</div>

<style>
  .intro {
    display: none;
  }

  :global(html.intro-playing) .intro,
  .intro.is-visible {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--paper);
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .intro.intro-exit {
    transform: translateY(-100%);
  }

  :global(html.intro-playing) {
    overflow: hidden;
  }

  .intro-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--vermillion);
    animation: intro-progress 1.1s var(--ease-out) both;
  }

  .intro-rows {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0;
  }

  .intro-row {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(2.6rem, 12.5vw, 11rem);
    font-weight: 300;
    line-height: 0.94;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--ink);
    animation: intro-row-in 0.55s var(--ease-out) both;
  }

  /* Alternating rows: hairline outline, sliding in from the right */
  .intro-row:nth-child(odd) {
    color: transparent;
    -webkit-text-stroke: 1px var(--ink-faint);
    animation-name: intro-row-in-r;
  }

  .intro-row:nth-child(2) {
    animation-delay: 0.05s;
  }

  .intro-row:nth-child(3) {
    animation-delay: 0.1s;
  }

  .intro-row:nth-child(4) {
    animation-delay: 0.15s;
  }

  @keyframes intro-row-in {
    from {
      transform: translateX(-108%);
    }
    to {
      transform: translateX(0);
    }
  }

  @keyframes intro-row-in-r {
    from {
      transform: translateX(108%);
    }
    to {
      transform: translateX(0);
    }
  }

  @keyframes intro-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Calmer path when the OS asks for less motion: the name
     still fills the screen, but rows fade instead of sliding. */
  @media (prefers-reduced-motion: reduce) {
    .intro-row,
    .intro-row:nth-child(odd) {
      animation-name: intro-row-fade;
    }

    .intro.intro-exit {
      transform: none;
      opacity: 0;
      transition:
        opacity 0.45s ease,
        transform 0s;
    }
  }

  @keyframes intro-row-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  const HOLD_MS = 1100;
  const EXIT_MS = 720;
  const intro = document.querySelector('[data-intro]');
  const playing = document.documentElement.classList.contains('intro-playing');

  if (intro && playing) {
    let exited = false;
    intro.classList.add('is-visible');

    const exit = () => {
      if (exited) return;
      exited = true;
      intro.classList.add('intro-exit');
      document.documentElement.classList.remove('intro-playing');
      window.__introExited = true;
      window.__onIntroExit?.();
      window.dispatchEvent(new Event('intro:exit'));
      window.setTimeout(() => intro.remove(), EXIT_MS);
    };

    window.setTimeout(exit, HOLD_MS);
    intro.addEventListener('click', exit);
  } else if (intro) {
    intro.remove();
  }
</script>
